{
  "name": "xmplus",
  "version": "1.0.1",
  "description": "X+ lets you write pages in a structured XML dialect, run them on a Node.js server with real API routes, and export them as plain static HTML — all from the same source files.",
  "keywords": ["html", "transpiler", "cli", "web"],
  "homepage": "https://github.com/reaudacity/xplus#readme",
  "bugs": {
    "url": "https://github.com/reaudacity/xplus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reaudacity/xplus.git"
  },
  "license": "MIT",
  "author": "AbdullahCXD",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "x+": "dist/bin/index.js",
    "xserver": "dist/bin/index.js"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "formatBuild": "bun run format && bun run build",
    "format": "prettier --write src/**/*.ts",
    "prepublish": "bun run formatBuild"
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "consola": "^3.4.2",
    "esbuild": "^0.27.4",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.5.8",
    "inquirer": "^13.3.2",
    "js-yaml": "^4.1.1",
    "lodash": "^4.17.23"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.5.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  }
}
